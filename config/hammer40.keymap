    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp ESCAPE  &kp Q     &kp W     &kp E      &kp R  &kp T               &kp Y      &kp U     &kp I      &kp O       &kp P                    &kp BACKSPACE
&kp TAB     &kp A     &kp S     &kp D      &kp F  &kp G               &kp H      &kp J     &kp K      &kp L       &Music_PlayNextPrevious  &kp ENTER
&kp LSHFT   &kp Z     &kp X     &kp C      &kp V  &kp B      &rot_td  &kp N      &kp M     &kp COMMA  &kp PERIOD  &kp UP_ARROW             &kp RSHFT
&kp LCTRL   &kp LALT  &kp LCMD  &kp GLOBE  &to 1  &kp SPACE  &to 2    &kp SPACE  &kp RGUI  &kp RCTRL  &kp LEFT    &kp DOWN_ARROW           &kp RIGHT
            >;
        };

        nav_layer {
            display-name = "nav";
            bindings = <
&to 0             &kp LG(LA(DOWN))  &trans  &kp N7        &kp N8        &kp N9                &kp DELETE     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp N7        &kp N8        &kp N9
&kp LC(CAPSLOCK)  &trans            &kp A   &kp NUMBER_4  &kp N5        &kp NUMBER_6          &kp PAGE_UP    &kp SEMI          &kp APOSTROPHE     &kp NUMBER_4  &kp N5        &kp NUMBER_6
&kp LEFT_SHIFT    &trans            &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &kp PAGE_DOWN  &kp PERIOD        &kp QUESTION       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3
&trans            &trans            &trans  &trans        &kp DOT       &kp N0        &to 2   &kp LA(SPACE)  &kp PAGE_UP       &kp PAGE_DOWN      &kp N0        &kp KP_DOT    &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        layer_2 {
            bindings = <
&to 3         &to 4         &to 5         &to 13        &to 14        &to 15                             &to 9                 &to 5         &to 10              &to 11         &to 12         &to 13
&to 16        &to 16        &to 13        &to 0         &to 0         &to 16                             &kp LEFT_BRACE        &kp LEFT      &kp DOWN            &kp UP         &kp RIGHT      &kp NUMBER_1
&to 2         &trans        &trans        &to 6         &to 7         &to 8       &kp C_BRIGHTNESS_AUTO  &kp LEFT_PARENTHESIS  &kp LG(LEFT)  &kp LA(LEFT_ARROW)  &kp LA(RIGHT)  &kp LG(RIGHT)  &kp RIGHT_PARENTHESIS
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_PRV  &to 2                  &bt BT_NXT            &bt BT_SEL 4  &bt BT_CLR_ALL      &bt BT_PRV     &bt BT_CLR     &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        Procreate {
            bindings = <
&trans        &kp LG(BACKSPACE)  &trans  &kp LG(B)       &kp C_VOLUME_UP   &kp C_BRIGHTNESS_INC          &kp BACKSPACE      &kp LG(D)   &Copy_cut  &paste_duplicate                &kp LG(RIGHT_BRACKET)    &kp RIGHT_BRACE
&trans        &trans             &trans  &trans          &kp C_VOL_DN      &kp C_BRIGHTNESS_DEC          &Procreate_K_U_B   &kp LG(U)   &kp LG(B)  &kp LG(SEMI)                    &kp LG(LEFT_BRACKET)     &kp LEFT_BRACE
&to 2         &trans             &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT            &trans  &kp LG(SEMICOLON)  &kp LG(J)   &kp SPACE  &Procreate_selection_Trandform  &Procreate_Color_layers  &Procreate_eraser_brush
&kp LEFT_GUI  &trans             &trans  &trans          &trans            &kp TAB               &to 2   &kp LG(TAB)        &kp LG(N0)  &kp M      &kp X                           &kp LG(LS(Z))            &kp LG(Z)
            >;

            sensor-bindings = <&inc_dec_kp LG(LEFT_BRACKET) LG(RIGHT_BRACKET)>;
        };

        Prodrafts {
            bindings = <
&Procreate_eraser_brush       &kp NUMBER_2                   &kp NUMBER_4  &kp NUMBER_6  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC                    &kp BACKSPACE  &kp LG(EQUAL)      &Copy_cut          &paste_duplicate         &kp LG(MINUS)               &kp LG(EQUAL)
&Prodrafts_Lasso_backspace    &kp NUMBER_3                   &kp N5        &kp N7        &kp C_VOL_DN     &kp C_BRIGHTNESS_DEC                    &kp LG(V)      &kt LG(C)          &kp LG(X)          &Prodrafts_tape_sticker  &Prodrafts_Lasso_backspace  &Prodrafts_rectangle_Artboard
&Prodrafts_100cent_Immersive  &Prodrafts_rectangle_Artboard  &kp F         &kp T         &kp L            &kp T                 &kp LG(NUMBER_1)  &kp X          &kp LG(ENTER)      &kp LG(LS(ENTER))  &kp LG(BACKSPACE)        &kp UP_ARROW                &Prodrafts_100cent_Immersive
&kp LG(Z)                     &kp LG(LS(Z))                  &kp LG(TAB)   &kp N5        &kp NUMBER_6     &kp LG(N0)            &to 2             &kp LG(TAB)    &kp LG(BACKSPACE)  &kp LG(N0)         &kp LEFT                 &kp DOWN_ARROW              &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        ProDrafts2 {
            bindings = <
&Prodrafts_100cent_Immersive   &kp NUMBER_3  &kp NUMBER_2  &kp LG(Z)      &kp R                 &kp T                         &kp Y   &kp U   &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&Prodrafts_rectangle_Artboard  &kp N5        &kp NUMBER_4  &kp LG(LS(Z))  &kp F                 &kp C_VOLUME_UP               &kp H   &kt J   &kp K      &kp L       &kp SEMICOLON  &kp RIGHT_BRACKET
&Prodrafts_Lasso_backspace     &kp N7        &kp NUMBER_6  &kp C          &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp APOS       &kp SLASH
&Procreate_eraser_brush        &kp LG(N0)    &kp LG(TAB)   &kp N5         &kp NUMBER_6          &kp F1                &to 2   &kp F3  &kp N7  &kp N8     &kp N9      &kp N0         &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        Concepts {
            bindings = <
&kp NUMBER_1  &kp Q         &kp W         &kp E   &kp R         &kp T               &kp Y   &kp U   &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&kp NUMBER_2  &kp A         &kp S         &kp D   &kp F         &kp G               &kp H   &kt J   &kp K      &kp L       &kp SEMICOLON  &kp RIGHT_BRACKET
&to 2         &kp Z         &kp X         &kp C   &kp V         &kp B   &kp LG(N0)  &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp APOS       &kp SLASH
&kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp F1  &to 2       &kp F3  &kp N7  &kp N8     &kp N9      &kp N0         &kp RIGHT_SHIFT
            >;

