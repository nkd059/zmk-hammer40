        };

        Crafts {
            bindings = <
&kp DELETE   &Craft_home_Close_new  &Craft_forw_back_new       &kp LG(MINUS)  &kp LG(EQUAL)  &Craft_focus_sidebar            &kp ESCAPE      &kp ENTER      &Bold_italics_strikethrough  &Craft_headings_2_tripletap  &Craft_headings_1_tripletap  &kp LG(LA(UP_ARROW))
&kp LC(TAB)  &Craft_home_Close_new  &kp LC(C_BRIGHTNESS_INC)   &none          &none          &Craft_copy_cut_paste           &Colors_1       &Colors_2      &Craft_page_card             &Craft_List_toggle_2         &Craft_List_Toggle_1         &kp LG(LA(DOWN_ARROW))
&to 2        &none                  &kp LC(C_BRIGHTNESS_DEC)   &kp C_PREV     &kp C_PP       &kp C_NEXT             &rot_td  &Colors_3       &Colors_4      &Craft_insert_new_Drawing    &kp LS(TAB)                  &kp UP_ARROW                 &kp TAB
&kp LG(TAB)  &kp LEFT_GUI           &Craft_insert_new_Drawing  &kp LG(LS(Z))  &kp LG(Z)      &kp SLASH              &to 2    &kp LEFT_SHIFT  &kp LG(LS(C))  &kp LG(LS(B))                &kp LEFT                     &kp DOWN_ARROW               &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        Crafts_2 {
            bindings = <
&craft_Default_color  &Craft_Red    &Craft_Orange  &Craft_pink       &Craft_brown       &craft_grey                &kp Y   &kp U   &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&craft_clear_style    &craft_green  &craft_olive   &craft_navy_blue  &craft_ocean_blue  &craft_light_grey          &kp H   &kt J   &kp K      &kp L       &kp SEMICOLON  &kp RIGHT_BRACKET
&to 2                 &kp Z         &kp X          &kp C             &kp V              &kp B              &trans  &kp N   &kp M   &kp COMMA  &kp PERIOD  &kp APOS       &kp SLASH
&kp NUMBER_3          &kp NUMBER_4  &kp NUMBER_4   &kp N5            &kp NUMBER_6       &kp F1             &to 2   &kp F3  &kp N7  &kp N8     &kp N9      &kp N0         &kp RIGHT_SHIFT
            >;

